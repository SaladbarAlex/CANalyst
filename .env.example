# Copy to backend/.env (or export in your shell) and fill in as needed.

# Which explanation backend to use: mock | claude | openai | rcd
EXPLAINER=mock

# Only needed for the hosted backends.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Clemson RCD LLM Service (on campus or CUVPN). Key from https://llm.rcd.clemson.edu
# RCD_LLM_API_KEY=...
# RCD_LLM_MODEL=glm-5.1-fp8
# RCD_LLM_BASE_URL=https://llm.rcd.clemson.edu/v1

# Extra origins allowed to call the API (the Vite dev server is allowed by default).
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
