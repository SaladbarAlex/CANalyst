# Copy to backend/.env (or export in your shell) and fill in as needed.

# Backend or exact selector: mock | claude | openai | rcd:glm-5.3 | rcd:gemma-4-31b
EXPLAINER=mock

# Only needed for the hosted backends.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Clemson RCD LLM Service (on campus or CUVPN). Key from https://llm.rcd.clemson.edu
# RCD_LLM_API_KEY=...
# RCD_LLM_MODEL=glm-5.3
# RCD_LLM_MODELS=glm-5.3,gemma-4-31b
# RCD_LLM_BASE_URL=https://llm.rcd.clemson.edu/v1

# Bounded requests and reproducible cache keys. GLM-5.3 defaults to low reasoning
# effort; its default server reasoning consumed the token limit without an answer.
# LLM_TIMEOUT_S=90
# LLM_MAX_TOKENS=1800
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=low
# Add gpt-4o-mini to RCD_LLM_MODELS only for a commercial-gateway comparison;
# this uses external hosting/credits, unlike campus-hosted RCD models.

# Extra origins allowed to call the API (the Vite dev server is allowed by default).
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
